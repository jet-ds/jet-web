---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageWrapper from '../../components/layout/PageWrapper.astro';
import Container from '../../components/ui/Container.astro';
import WorkCard from '../../components/works/WorkCard.astro';
import CollectionFilterEnhancement from '../../components/filters/CollectionFilterEnhancement.astro';
import { resolveWorksCollection } from '../../features/collections/resolveCollections';

const sortedWorks = resolveWorksCollection(await getCollection('works'));
const workCounts = {
  all: sortedWorks.length,
  research: sortedWorks.filter((work) => work.kind === 'research').length,
  project: sortedWorks.filter((work) => work.kind === 'project').length,
  other: sortedWorks.filter((work) => work.kind === 'other').length,
};
const workTypes = [
  { value: 'research', label: 'Research', count: workCounts.research },
  { value: 'project', label: 'Projects', count: workCounts.project },
  ...(workCounts.other > 0
    ? [{ value: 'other', label: 'Other', count: workCounts.other }]
    : []),
];
const pageDescription =
  "Explore Jet Sanchez's research papers, software projects, and applied AI experiments spanning agentic systems, AI governance, and emerging technology.";
const pageSubheading =
  'Explore my research papers, software projects, and applied AI experiments spanning agentic systems, AI governance, and emerging technology.';
---

<BaseLayout title="Works" description={pageDescription}>
  <PageWrapper spacing="compact">
    <Container size="lg">
      <div
        data-collection-filter
        data-filter-param="type"
        data-filter-singular="work"
        data-filter-plural="works"
        data-filter-context-template=" in the {value} category"
      >
        <div class="mb-xl">
          <h1 class="text-5xl font-bold leading-tight mb-s">Works</h1>
          <p class="text-xl text-text-tertiary max-w-[var(--container-2xl)]">
            {pageSubheading}
          </p>
        </div>

        {
          sortedWorks.length > 0 && (
            <section
              data-filter-enhancement
              hidden
              aria-label="Works filters and result count"
              class="mb-l"
            >
              <div
                role="group"
                aria-label="Filter works by type"
                class="flex flex-wrap gap-2xs"
              >
                <button
                  type="button"
                  data-filter-value=""
                  data-action-variant="filter"
                  data-action-density="compact"
                  aria-pressed="true"
                  class="action action--filter action--compact px-s"
                >
                  All ({workCounts.all})
                </button>
                {workTypes.map(({ value, label, count }) => (
                  <button
                    type="button"
                    data-filter-value={value}
                    data-action-variant="filter"
                    data-action-density="compact"
                    aria-pressed="false"
                    class="action action--filter action--compact px-s"
                  >
                    {label} ({count})
                  </button>
                ))}
              </div>
              <p
                data-filter-status
                role="status"
                aria-live="polite"
                aria-atomic="true"
                class="mt-s text-sm text-text-tertiary"
              >
                {workCounts.all} {workCounts.all === 1 ? 'work' : 'works'}
              </p>
            </section>
          )
        }

        {
          sortedWorks.length > 0 && (
            <section data-filter-section>
              <div class="grid grid-cols-1 gap-l md:grid-cols-2">
                {sortedWorks.map((work) => (
                  <WorkCard record={work} />
                ))}
              </div>
            </section>
          )
        }

        {
          sortedWorks.length === 0 && (
            <div class="text-center py-xl">
              <p class="text-text-tertiary text-lg">
                No works yet. Check back soon!
              </p>
            </div>
          )
        }

        <div data-filter-empty hidden class="text-center py-xl">
          <p data-filter-empty-message class="text-text-tertiary text-lg"></p>
        </div>

        <CollectionFilterEnhancement />
      </div>
    </Container>
  </PageWrapper>
</BaseLayout>
