---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Link from '../components/ui/Link.astro';
import Button from '../components/ui/Button.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { SITE, SOCIAL_LINKS } from '../config/site';

const profile = await getEntry('profile', 'jet-sanchez');
if (profile === undefined) {
  throw new Error(
    'Required canonical profile is missing: profile:jet-sanchez.',
  );
}
const { Content } = await render(profile);

// Map platform keys to proper brand names
const platformNames: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  ssrn: 'SSRN',
  scholar: 'Google Scholar',
};

const activeSocialLinks = Object.entries(SOCIAL_LINKS)
  .filter(([_, url]) => url)
  .map(([platform, url]) => ({
    platform: platformNames[platform],
    url,
  }));
---

<BaseLayout
  title="AI Research & Marketing Engineering"
  description={profile.data.description}
  type="profile"
  mainEntityId={`${SITE.siteUrl}/#person`}
>
  <StructuredData
    slot="structured-data"
    type="person"
    id={`${SITE.siteUrl}/#person`}
    name={SITE.author}
    givenName={SITE.givenName}
    familyName={SITE.familyName}
    alternateName={SITE.alternateNames}
    jobTitle={profile.data.role}
    worksFor={{
      name: profile.data.organization,
      url: profile.data.organizationUrl,
    }}
    email={SITE.email}
    url={`${SITE.siteUrl}/`}
    pageUrl={`${SITE.siteUrl}/about/`}
    sameAs={Object.values(SOCIAL_LINKS).filter((url) => url)}
  />

  <PageWrapper spacing="default">
    <Container size="lg">
      <!-- Header -->
      <div class="mb-xl">
        <h1 class="text-5xl font-bold leading-tight mb-s text-text-primary">
          About
        </h1>
        <p class="text-xl text-text-tertiary">
          Research, systems, and applied AI
        </p>
      </div>

      <!-- Bio Section with Image -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-m-l mb-l items-stretch">
        <!-- Background Card -->
        <Card surface="subtle">
          <div class="prose prose-lg dark:prose-invert max-w-none">
            <h2 class="text-2xl font-bold leading-tight mb-s">Background</h2>
            <Content />
          </div>
        </Card>

        <!-- Image Card -->
        <Card clip padding="none" radius="xl">
          <OptimizedImage
            src="https://vyge4wbmw8jgd8rh.public.blob.vercel-storage.com/images/about/about-hero-b0ab33a5.jpg"
            alt="Jet Sanchez"
            width={1200}
            height={1600}
            class="w-full h-full object-cover"
            loading="eager"
            quality={85}
          />
        </Card>
      </div>

      <!-- Interests & Expertise -->
      <Card surface="subtle" class="mb-l">
        <h2 class="text-2xl font-bold mb-m text-text-primary">
          Interests & Expertise
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-m">
          <div>
            <h3 class="text-lg font-semibold mb-xs text-accent-text">
              Research Areas
            </h3>
            <ul class="space-y-2xs text-text-secondary">
              {profile.data.researchAreas.map((area) => <li>• {area}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-xs text-accent-text">
              Technical Focus
            </h3>
            <ul class="space-y-2xs text-text-secondary">
              {profile.data.technicalFocus.map((focus) => <li>• {focus}</li>)}
            </ul>
          </div>
        </div>
      </Card>

      <!-- Connect Section -->
      <Card surface="subtle">
        <h2 class="text-2xl font-bold mb-m text-text-primary">Connect</h2>
        <p class="text-text-secondary mb-m">
          {profile.data.connectText}
        </p>

        {
          activeSocialLinks.length > 0 ? (
            <div class="flex flex-wrap gap-s">
              {activeSocialLinks.map((social) => (
                <Button
                  href={social.url}
                  external
                  variant="brand"
                  density="compact"
                >
                  {social.platform}
                  <span class="text-xs text-accent-base" aria-hidden="true">
                    ↗
                  </span>
                  <span class="sr-only">(opens in a new tab)</span>
                </Button>
              ))}
            </div>
          ) : (
            <div class="space-y-xs">
              <div class="flex items-center gap-xs text-text-tertiary">
                <span class="font-semibold">Email:</span>
                <Link href={`mailto:${SITE.email}`} variant="primary">
                  {SITE.email}
                </Link>
              </div>
              <p class="text-sm text-text-tertiary">
                Social links can be configured in the site configuration.
              </p>
            </div>
          )
        }
      </Card>
    </Container>
  </PageWrapper>
</BaseLayout>
