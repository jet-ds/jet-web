---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Link from '../components/ui/Link.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { SITE, SOCIAL_LINKS } from '../config/site';

// Map platform keys to proper brand names
const platformNames: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  ssrn: 'SSRN',
  scholar: 'Google Scholar',
};

const activeSocialLinks = Object.entries(SOCIAL_LINKS)
  .filter(([_, url]) => url)
  .map(([platform, url]) => ({
    platform: platformNames[platform],
    url,
  }));
---

<BaseLayout
  title="Jet Sanchez | AI Research & Marketing Engineering"
  description="Jet Sanchez works at the intersection of frontier AI research, marketing engineering, systems design, agentic AI orchestration, and next-gen SEO & GEO strategy."
  type="profile"
>
  <!-- Canonical Person Identity for SEO -->
  <StructuredData
    type="person"
    id={`${SITE.siteUrl}/#person`}
    name={SITE.author}
    givenName={SITE.givenName}
    familyName={SITE.familyName}
    alternateName={SITE.alternateNames}
    jobTitle={SITE.jobTitle}
    email={SITE.email}
    url={SITE.siteUrl}
    sameAs={Object.values(SOCIAL_LINKS).filter(url => url)}
  />

  <Container size="md" class="py-16">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-foreground dark:text-foreground-dark">
        About
      </h1>
      <p class="text-xl text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark">
        Research, systems, and applied AI
      </p>
    </div>

    <!-- Bio Section -->
    <Card class="mb-8">
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <h2 class="text-2xl font-bold mb-4">Background</h2>
        <p>
          I am a marketing engineer working at the intersection of AI research, applied AI, and systems design.
        </p>
        <p>
          At Digital Squad, I lead AI research & development and drive content strategy and SEO, building internal AI maturity, designing practical AI-enabled workflows, and translating complex technical ideas into execution that drives results.
        </p>
        <p>
          Alongside that work, I write and publish research exploring long-term trajectories in advanced AI, especially where capability, governance, and ethics collide.
        </p>
        <p>
          This site is my public workspace: papers, essays, and experiments in thinking, plus the systems that ship them.
        </p>
      </div>
    </Card>

    <!-- Interests & Expertise -->
    <Card class="mb-8">
      <h2 class="text-2xl font-bold mb-6 text-foreground dark:text-foreground-dark">
        Interests & Expertise
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-semibold mb-3 text-primary-600 dark:text-primary-400">
            Research Areas
          </h3>
          <ul class="space-y-2 text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark">
            <li>• Artificial Intelligence</li>
            <li>• AI Safety & Alignment</li>
            <li>• Recursive and Complex Systems</li>
            <li>• Cognitive Architectures</li>
            <li>• Machine Theory of Mind (ToM)</li>
            <li>• Future of Technology</li>
            <li>• Technology Policy & Governance</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-3 text-primary-600 dark:text-primary-400">
            Technical Focus
          </h3>
          <ul class="space-y-2 text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark">
            <li>• Marketing Engineering</li>
            <li>• SEO & GEO Strategy</li>
            <li>• Applied Business Logic & Systems Integration</li>
            <li>• Agentic AI Orchestration</li>
            <li>• RAG Pipeline Design & Engineering</li>
            <li>• Full-Stack AI Product Leadership & Delivery</li>
            <li>• Modern JavaScript / TypeScript / Astro</li>
          </ul>
        </div>
      </div>
    </Card>

    <!-- Connect Section -->
    <Card>
      <h2 class="text-2xl font-bold mb-6 text-foreground dark:text-foreground-dark">
        Connect
      </h2>
      <p class="text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark mb-6">
        I'm always interested in connecting with people doing serious work in AI, research, governance, or future-ready strategy. If something here resonates or you want to collaborate, feel free to reach out.
      </p>

      {activeSocialLinks.length > 0 ? (
        <div class="flex flex-wrap gap-4">
          {activeSocialLinks.map((social) => (
            <Link
              href={social.url}
              external
              variant="primary"
              class="inline-flex items-center px-4 py-2 rounded-lg bg-primary-50 dark:bg-primary-950/20 hover:bg-primary-100 dark:hover:bg-primary-950/40 transition-colors"
            >
              {social.platform}
            </Link>
          ))}
        </div>
      ) : (
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark">
            <span class="font-semibold">Email:</span>
            <Link href={`mailto:${SITE.email}`} variant="primary">
              {SITE.email}
            </Link>
          </div>
          <p class="text-sm text-muted-foreground dark:text-muted-foreground-dark dark:text-muted-foreground-dark">
            Social links can be configured in the site configuration.
          </p>
        </div>
      )}
    </Card>
  </Container>
</BaseLayout>
