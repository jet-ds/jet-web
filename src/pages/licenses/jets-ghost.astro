---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageWrapper from '../../components/layout/PageWrapper.astro';
import Container from '../../components/ui/Container.astro';
---

<BaseLayout
  title="Model and open-source licenses"
  description="License, provenance, and third-party notice details for the exact model and browser runtime used by Jet's Ghost."
>
  <PageWrapper spacing="default">
    <Container size="md">
      <article class="space-y-xl">
        <header class="max-w-3xl space-y-s">
          <p class="font-mono text-sm font-medium uppercase tracking-wide text-brand-text">
            Jet's Ghost
          </p>
          <h1 class="text-5xl font-bold leading-tight text-text-primary">
            Model and open-source licenses
          </h1>
          <p class="text-base leading-relaxed text-text-secondary">
            Jet's Ghost uses a pinned Gemma 4 E2B model and a small set of
            browser runtime and retrieval libraries. This page keeps their
            exact identities, licenses, and notices available in one stable
            place.
          </p>
        </header>

        <section aria-labelledby="model-license" class="space-y-s">
          <h2 id="model-license" class="text-3xl font-bold text-text-primary">
            Model
          </h2>
          <div class="rounded-xl border border-border-default bg-bg-subtle p-card">
            <h3 class="text-xl font-semibold text-text-primary">Gemma 4 E2B LiteRT-LM</h3>
            <dl class="mt-s grid gap-xs text-sm sm:grid-cols-[max-content_1fr]">
              <dt class="font-medium text-text-primary">Repository</dt>
              <dd class="break-words font-mono text-text-secondary">litert-community/gemma-4-E2B-it-litert-lm</dd>
              <dt class="font-medium text-text-primary">Revision</dt>
              <dd class="break-all font-mono text-text-secondary">9262660a1676eed6d0c477ab1a86344430854664</dd>
              <dt class="font-medium text-text-primary">Filename</dt>
              <dd class="break-words font-mono text-text-secondary">gemma-4-E2B-it-web.litertlm</dd>
              <dt class="font-medium text-text-primary">License</dt>
              <dd><a class="text-brand-text underline underline-offset-4 hover:text-brand-hover" href="/licenses/apache-2.0.txt">Apache License 2.0</a></dd>
            </dl>
            <p class="mt-s text-sm leading-relaxed text-text-secondary">
              The browser downloads this pinned model directly from Hugging Face only after an explicit visitor action. The site does not mirror or rename the model file.
            </p>
          </div>
        </section>

        <section aria-labelledby="bundle-licenses" class="space-y-s">
          <h2 id="bundle-licenses" class="text-3xl font-bold text-text-primary">
            Runtime and retrieval libraries
          </h2>
          <ul class="grid gap-xs">
            <li class="rounded-xl border border-border-default bg-bg-subtle p-card">
              <p class="font-semibold text-text-primary">LiteRT-LM 0.14.0 and LiteRT wasm-utils 2.5.0</p>
              <p class="mt-2xs text-sm text-text-secondary"><a class="text-brand-text underline underline-offset-4 hover:text-brand-hover" href="/assistant/runtime/litert-lm/0.14.0/LICENSE.txt">Versioned Apache License 2.0 sibling</a></p>
            </li>
            <li class="rounded-xl border border-border-default bg-bg-subtle p-card">
              <p class="font-semibold text-text-primary">MiniSearch 7.2.0</p>
              <p class="mt-2xs text-sm text-text-secondary"><a class="text-brand-text underline underline-offset-4 hover:text-brand-hover" href="/licenses/minisearch-7.2.0-MIT.txt">MIT license</a></p>
            </li>
            <li class="rounded-xl border border-border-default bg-bg-subtle p-card">
              <p class="font-semibold text-text-primary">stemmer 2.0.1</p>
              <p class="mt-2xs text-sm text-text-secondary"><a class="text-brand-text underline underline-offset-4 hover:text-brand-hover" href="/licenses/stemmer-2.0.1-MIT.txt">MIT license</a></p>
            </li>
          </ul>
        </section>

        <section aria-labelledby="notices" class="space-y-s">
          <h2 id="notices" class="text-3xl font-bold text-text-primary">Complete notices</h2>
          <p class="max-w-3xl text-base leading-relaxed text-text-secondary">
            The complete notice index records the exact package pins, model and runtime asset hashes, observed copyright statements, and modification status.
          </p>
          <a class="inline-flex min-h-11 items-center rounded-lg border border-border-default px-s font-medium text-brand-text transition-colors hover:bg-bg-hover focus:outline-none focus:ring-2 focus:ring-brand-base" href="/licenses/THIRD_PARTY_NOTICES.md">
            Read THIRD_PARTY_NOTICES.md
          </a>
        </section>

        <p class="max-w-3xl border-t border-border-default pt-s text-sm leading-relaxed text-text-tertiary">
          These acknowledgements identify upstream work and do not imply endorsement of Jet's Ghost or this website by any named author, organization, or project.
        </p>
      </article>
    </Container>
  </PageWrapper>
</BaseLayout>
