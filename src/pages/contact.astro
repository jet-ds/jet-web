---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import { SITE, SOCIAL_LINKS } from '../config/site';

const contactLinks = [
  {
    name: 'GitHub',
    url: SOCIAL_LINKS.github,
    description: 'Code, experiments, and open-source work',
  },
  {
    name: 'LinkedIn',
    url: SOCIAL_LINKS.linkedin,
    description: 'Professional profile and updates',
  },
  {
    name: 'SSRN',
    url: SOCIAL_LINKS.ssrn,
    description: 'Research papers and publications',
  },
  {
    name: 'Google Scholar',
    url: SOCIAL_LINKS.scholar,
    description: 'Academic citations and research profile',
  },
].filter(({ url }) => url);
---

<BaseLayout
  title="Contact"
  description="Contact Jet Sanchez for AI research, marketing engineering, SEO and GEO strategy, systems design, speaking, or collaboration opportunities."
>
  <PageWrapper spacing="default">
    <Container size="md">
      <!-- Header -->
      <div class="mb-xl text-center">
        <h1 class="text-5xl font-bold leading-tight mb-s text-text-primary">
          Get in Touch
        </h1>
        <p class="text-xl text-text-tertiary">
          I'd love to hear from you. Here's how you can reach me.
        </p>
      </div>

      <div class="space-y-m">
        <Card surface="subtle">
          <div
            class="flex flex-col md:flex-row md:items-center md:justify-between gap-s"
          >
            <div class="flex-1">
              <h2 class="text-xl font-semibold mb-2xs text-text-primary">
                Email
              </h2>
              <p class="text-text-secondary mb-xs">
                The best way to reach me for inquiries, collaborations, or just
                to say hello.
              </p>
              <Link href={`mailto:${SITE.email}`} variant="primary">
                {SITE.email}
              </Link>
            </div>
            <Button
              href={`mailto:${SITE.email}`}
              variant="accent"
              density="default"
            >
              Send email
            </Button>
          </div>
        </Card>

        {
          contactLinks.length > 0 && (
            <Card surface="subtle">
              <h2 class="text-xl font-semibold mb-s text-text-primary">
                Links
              </h2>
              <p class="text-text-secondary mb-m">
                Find my profiles, publications, and open-source work
              </p>
              <div class="space-y-s">
                {contactLinks.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-start justify-between p-s rounded-lg border border-border-default hover:border-brand-base hover:bg-bg-hover transition-all group"
                  >
                    <span>
                      <span class="block font-medium text-text-primary group-hover:text-brand-text">
                        {link.name}
                      </span>
                      <span class="block text-sm text-text-tertiary mt-3xs">
                        {link.description}
                      </span>
                    </span>
                    <span
                      class="text-accent-base flex-shrink-0 ml-s"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                ))}
              </div>
            </Card>
          )
        }
      </div>
    </Container>
  </PageWrapper>
</BaseLayout>
