---
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { EGREGORE_IDENTITY } from '../config/egregore';
import { SITE } from '../config/site';
import EgregoreExperience from '../features/egregore/EgregoreExperience';
import packageJson from '../../package.json';

const title = 'Egregore: Local-First AI Assistant';
const description =
  "Chat with Jet's published writing, research, and projects using a local-first AI assistant in compatible WebGPU browsers.";
const canonicalUrl = new URL(
  EGREGORE_IDENTITY.canonicalPath,
  SITE.siteUrl,
).toString();
const softwareApplicationId = `${canonicalUrl}#softwareapplication`;
const noindex = process.env.VERCEL_ENV !== 'production';
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalUrl}
  mainEntityId={softwareApplicationId}
  noindex={noindex}
  immersive
>
  <StructuredData
    slot="structured-data"
    type="software"
    id={softwareApplicationId}
    url={canonicalUrl}
    name={EGREGORE_IDENTITY.name}
    applicationCategory="ChatApplication"
    operatingSystem="Web browser with WebGPU"
  />

  <EgregoreExperience client:load appVersion={packageJson.version} />

  <noscript>
    <section
      class="fixed inset-0 z-40 grid place-items-center bg-bg-base px-gutter text-text-primary"
      aria-labelledby="egregore-noscript-title"
    >
      <div class="max-w-[var(--container-2xl)] text-center">
        <p
          class="mb-xs font-mono text-sm uppercase tracking-wider text-brand-text"
        >
          Local-first AI
        </p>
        <h1
          id="egregore-noscript-title"
          class="mb-s font-serif text-3xl font-bold"
        >
          Egregore needs JavaScript and WebGPU
        </h1>
        <p
          class="mx-auto max-w-[var(--container-xl)] text-base leading-relaxed text-text-secondary"
        >
          This assistant runs its model in a compatible browser. You can still
          explore Jet's published thinking in the <a
            class="text-link"
            href="/blog/">Blog</a
          >
          and <a class="text-link" href="/works/">Works</a>.
        </p>
      </div>
    </section>
  </noscript>
</BaseLayout>

<style is:global>
  .egregore-header {
    padding-top: max(
      var(--space-m),
      var(--navigation-top-clearance),
      env(safe-area-inset-top)
    );
  }

  .egregore-composer {
    padding-bottom: var(--navigation-bottom-exclusion);
  }

  .egregore-scroll-surface {
    padding-bottom: var(--navigation-bottom-exclusion);
  }
</style>
