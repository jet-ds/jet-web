---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { SITE, SOCIAL_LINKS } from '../config/site';

// Fetch latest blog posts (limit to 3)
const allBlogPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const latestPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Fetch featured works
const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .filter((work) => work.data.featured === true)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Type labels
const typeLabel: Record<string, string> = {
  research: 'Research',
  project: 'Project',
  other: 'Other',
};
---

<BaseLayout
  title="Research, Systems & Applied AI"
  description="Jet Sanchez produces research, systems, and tools for thinking clearly in an AI-driven world, with a focus on applied AI and emerging technologies."
  suppressWebPage={true}
>
  <StructuredData
    slot="structured-data"
    type="website"
    url={SITE.siteUrl}
    name={SITE.title}
    description={SITE.description}
  />

  <StructuredData
    slot="structured-data"
    type="person"
    id={`${SITE.siteUrl}/#person`}
    name={SITE.author}
    givenName={SITE.givenName}
    familyName={SITE.familyName}
    alternateName={SITE.alternateNames}
    jobTitle={SITE.jobTitle}
    email={SITE.email}
    url={SITE.siteUrl}
    sameAs={Object.values(SOCIAL_LINKS).filter(url => url)}
  />

  <!-- Hero Section -->
  <Section spacing="none" class="min-h-[75svh] flex items-center">
    <Container size="lg">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-7xl font-bold leading-tight mb-m text-text-primary">
          Hi,<br class="md:hidden"> I'm Jet Sanchez.
        </h1>
        <p class="text-base text-text-tertiary mb-l">
          Research, systems & tools for thinking clearly in an AI-driven world
        </p>
        <div class="flex flex-wrap gap-s justify-center">
          <Button href="/about" variant="accent" size="lg">About Me</Button>
          <Button href="/contact" variant="outline" size="lg">Get in Touch</Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Latest Blog Posts -->
  <Section spacing="default" background="subtle">
    <Container size="lg">
      <div class="flex justify-between items-center mb-l">
        <h2 class="text-3xl font-bold leading-tight text-text-primary">
          Latest Articles
        </h2>
        <Button href="/blog" variant="ghost">View All<span class="text-accent-base"> →</span></Button>
      </div>

      {latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-m">
          {latestPosts.map((post) => (
            <Card hover class="flex flex-col h-full">
              <div class="flex-1">
                <h3 class="text-lg font-semibold leading-snug mb-2xs text-text-primary">
                  <a href={`/blog/${post.id}`} class="hover:text-brand-base transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                {post.data.image && (
                  <div class="aspect-video overflow-hidden rounded-lg mb-2xs">
                    <OptimizedImage
                      src={post.data.image.url}
                      alt={post.data.image.alt}
                      width={800}
                      height={450}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    />
                  </div>
                )}
                <p class="text-text-tertiary mb-s">
                  {post.data.description}
                </p>
                <div class="flex flex-wrap gap-2xs mb-s">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <Tag size="sm">{tag}</Tag>
                  ))}
                </div>
              </div>
              <div class="text-sm text-text-tertiary">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
            </Card>
          ))}
        </div>
      ) : (
        <Card>
          <p class="text-center text-text-tertiary py-l">
            No blog posts yet. Check back soon!
          </p>
        </Card>
      )}
    </Container>
  </Section>

  <!-- Featured Works -->
  <Section spacing="default">
    <Container size="lg">
      <div class="flex justify-between items-center mb-l">
        <h2 class="text-3xl font-bold leading-tight text-text-primary">
          Featured Works
        </h2>
        <Button href="/works" variant="ghost">View All<span class="text-accent-base"> →</span></Button>
      </div>

      {featuredWorks.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-m">
          {featuredWorks.map((work) => (
            <Card hover class="flex flex-col h-full">
              <div class="flex-1">
                <div class="flex items-center gap-2xs mb-xs">
                  <Tag
                    variant={work.data.type === 'research' ? 'primary' : work.data.type === 'project' ? 'primary' : 'default'}
                    size="sm"
                  >
                    {typeLabel[work.data.type]}
                  </Tag>
                </div>
                <h3 class="text-lg font-semibold leading-snug mb-2xs text-text-primary">
                  <a href={`/works/${work.id}`} class="hover:text-brand-base transition-colors">
                    {work.data.title}
                  </a>
                </h3>
                {work.data.image && (
                  <div class="aspect-video overflow-hidden rounded-lg mb-2xs">
                    <OptimizedImage
                      src={work.data.image.url}
                      alt={work.data.image.alt}
                      width={800}
                      height={450}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    />
                  </div>
                )}
                <p class="text-text-tertiary mb-s">
                  {work.data.description}
                </p>
                <div class="flex flex-wrap gap-2xs mb-s">
                  {work.data.tags.slice(0, 3).map((tag) => (
                    <Tag size="sm">{tag}</Tag>
                  ))}
                </div>
              </div>
              <div class="text-sm text-text-tertiary">
                {work.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
            </Card>
          ))}
        </div>
      ) : (
        <Card>
          <p class="text-center text-text-tertiary py-l">
            No featured works yet. Check back soon!
          </p>
        </Card>
      )}
    </Container>
  </Section>

  <!-- Call to Action -->
  <Section spacing="default" background="accent">
    <Container size="md">
      <div class="text-center">
        <h2 class="text-3xl font-bold mb-s text-text-primary">
          Let's Connect
        </h2>
        <p class="text-lg text-text-secondary mb-l">
          Interested in collaborating or have questions? Feel free to reach out!
        </p>
        <div class="flex flex-wrap justify-center gap-s">
          <Button href="/contact" variant="accent" size="lg">Contact Me</Button>
          <Button href="/about" variant="outline" size="lg">Learn More</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
