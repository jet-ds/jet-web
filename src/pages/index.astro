---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import WorkCard from '../components/works/WorkCard.astro';
import Grainient from '../components/ui/Grainient';
import { SITE, SOCIAL_LINKS } from '../config/site';
import { isPublished } from '../content/policy';

const homepageUrl = `${SITE.siteUrl}/`;
const profile = await getEntry('profile', 'jet-sanchez');
if (profile === undefined) {
  throw new Error(
    'Required canonical profile is missing: profile:jet-sanchez.',
  );
}

// Fetch latest blog posts (limit to 3)
const allBlogPosts = await getCollection('blog', ({ data }) =>
  isPublished(data),
);
const latestPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Fetch featured works
const allWorks = await getCollection('works', ({ data }) => isPublished(data));
const featuredWorks = allWorks
  .filter((work) => work.data.featured === true)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Research, Systems & Applied AI"
  description="Jet Sanchez produces research, systems, and tools for thinking clearly in an AI-driven world, with a focus on applied AI and emerging technologies."
  suppressWebPage={true}
>
  <StructuredData
    slot="structured-data"
    type="website"
    url={homepageUrl}
    name={SITE.title}
    description={SITE.description}
  />

  <StructuredData
    slot="structured-data"
    type="person"
    id={`${SITE.siteUrl}/#person`}
    name={SITE.author}
    givenName={SITE.givenName}
    familyName={SITE.familyName}
    alternateName={SITE.alternateNames}
    jobTitle={profile.data.role}
    email={SITE.email}
    url={homepageUrl}
    sameAs={Object.values(SOCIAL_LINKS).filter((url) => url)}
  />

  <!-- Hero Section -->
  <Section
    spacing="none"
    class="relative min-h-screen md:-mt-24 md:pt-24 flex items-center overflow-hidden"
  >
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <Grainient
        client:load
        color1="var(--color-brand-200-hex)"
        darkColor1="var(--color-brand-700-hex)"
        color2="var(--color-brand-500-hex)"
        darkColor2="var(--color-brand-800-hex)"
        color3="var(--color-accent-400-hex)"
        timeSpeed={1.0}
        colorBalance={0.0}
        warpStrength={1.0}
        warpFrequency={5.0}
        warpSpeed={2.0}
        warpAmplitude={50.0}
        blendAngle={0.0}
        blendSoftness={0.05}
        rotationAmount={500.0}
        noiseScale={2.0}
        grainAmount={0.1}
        grainScale={2.0}
        grainAnimated={true}
        contrast={1.5}
        gamma={1.0}
        saturation={1.0}
        centerX={0.0}
        centerY={0.0}
        zoom={1.75}
        overlayClassName="bg-bg-base/18 dark:bg-bg-base/24"
      />
    </div>

    <Container size="lg" class="relative z-10">
      <div class="max-w-[var(--container-4xl)] mx-auto text-center">
        <h1 class="text-7xl font-bold leading-tight mb-m text-text-primary">
          Hi,<br class="md:hidden" /> I'm Jet Sanchez.
        </h1>
        <p class="text-base text-text-secondary mb-l">
          Research, systems & tools for thinking clearly in an AI-driven world
        </p>
        <div class="flex flex-wrap gap-s justify-center">
          <Button href="/about/" variant="primary" density="immersive"
            >About me</Button
          >
          <Button href="/contact/" variant="accent" density="immersive"
            >Get in touch</Button
          >
        </div>
      </div>
    </Container>
  </Section>

  <!-- Latest Blog Posts -->
  <Section spacing="default" background="subtle">
    <Container size="lg">
      <div class="flex justify-between items-center mb-l">
        <h2 class="text-3xl font-bold leading-tight text-text-primary">
          Latest Articles
        </h2>
        <Button href="/blog/" variant="ghost"
          ><span>View all <span class="text-accent-base">→</span></span></Button
        >
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-m">
            {latestPosts.map((post) => (
              <BlogCard
                variant="compact"
                slug={post.id}
                title={post.data.title}
                shortTitle={post.data.shortTitle}
                description={post.data.description}
                summary={post.data.summary}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                image={post.data.image}
                content={post.body}
              />
            ))}
          </div>
        ) : (
          <Card>
            <p class="text-center text-text-tertiary py-l">
              No blog posts yet. Check back soon!
            </p>
          </Card>
        )
      }
    </Container>
  </Section>

  <!-- Featured Works -->
  <Section spacing="default">
    <Container size="lg">
      <div class="flex justify-between items-center mb-l">
        <h2 class="text-3xl font-bold leading-tight text-text-primary">
          Featured Works
        </h2>
        <Button href="/works/" variant="ghost"
          ><span>View all <span class="text-accent-base">→</span></span></Button
        >
      </div>

      {
        featuredWorks.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-m">
            {featuredWorks.map((work) => (
              <WorkCard
                variant="compact"
                slug={work.id}
                title={work.data.title}
                shortTitle={work.data.shortTitle}
                description={work.data.description}
                summary={work.data.summary}
                type={work.data.type}
                date={work.data.date}
                tags={work.data.tags}
                featured={work.data.featured}
                image={work.data.image}
                venue={work.data.venue}
                technologies={work.data.technologies}
                links={work.data.links}
              />
            ))}
          </div>
        ) : (
          <Card>
            <p class="text-center text-text-tertiary py-l">
              No featured works yet. Check back soon!
            </p>
          </Card>
        )
      }
    </Container>
  </Section>

  <!-- Call to Action -->
  <Section spacing="default" background="brand">
    <Container size="md">
      <div class="text-center">
        <h2 class="text-3xl font-bold mb-s text-text-primary">Let's Connect</h2>
        <p class="text-lg text-text-secondary mb-l">
          Interested in collaborating or have questions? Feel free to reach out!
        </p>
        <div class="flex flex-wrap justify-center gap-s">
          <Button href="/contact/" variant="accent" density="immersive"
            >Contact me</Button
          >
          <Button href="/about/" variant="brand" density="immersive"
            >Learn more</Button
          >
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
