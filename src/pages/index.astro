---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/ui/Container.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import HomeCollectionCarousel from '../components/content/HomeCollectionCarousel.astro';
import Grainient from '../components/ui/Grainient';
import { SITE, SOCIAL_LINKS } from '../config/site';
import {
  resolveHomepageBlog,
  resolveHomepageWorks,
} from '../features/collections/resolveCollections';
import type { CollectionDisplayRecord } from '../features/collections/types';

const homepageUrl = `${SITE.siteUrl}/`;
const profile = await getEntry('profile', 'jet-sanchez');
if (profile === undefined) {
  throw new Error(
    'Required canonical profile is missing: profile:jet-sanchez.',
  );
}

const allBlogPosts = await getCollection('blog');
const latestPosts = resolveHomepageBlog(allBlogPosts);

const allWorks = await getCollection('works');
const selectedWorks = resolveHomepageWorks(allWorks);

function toItemListItems(records: readonly CollectionDisplayRecord[]) {
  return records.map((record) => {
    const url = new URL(record.href, SITE.siteUrl).toString();
    const entityFragment =
      record.kind === 'blog'
        ? 'blogposting'
        : record.kind === 'research'
          ? 'scholarlyarticle'
          : 'creativework';

    return { url, entityId: `${url}#${entityFragment}` };
  });
}
---

<BaseLayout
  title="Research, Systems & Applied AI"
  description="Jet Sanchez produces research, systems, and tools for thinking clearly in an AI-driven world, with a focus on applied AI and emerging technologies."
  suppressWebPage={true}
>
  <StructuredData
    slot="structured-data"
    type="website"
    url={homepageUrl}
    name={SITE.title}
    description={SITE.description}
  />

  <StructuredData
    slot="structured-data"
    type="person"
    id={`${SITE.siteUrl}/#person`}
    name={SITE.author}
    givenName={SITE.givenName}
    familyName={SITE.familyName}
    alternateName={SITE.alternateNames}
    jobTitle={profile.data.role}
    worksFor={{
      name: profile.data.organization,
      url: profile.data.organizationUrl,
    }}
    email={SITE.email}
    url={homepageUrl}
    sameAs={Object.values(SOCIAL_LINKS).filter((url) => url)}
  />

  <StructuredData
    slot="structured-data"
    type="itemlist"
    id={`${homepageUrl}#latest-articles`}
    url={homepageUrl}
    name="Latest Articles"
    items={toItemListItems(latestPosts)}
  />

  <StructuredData
    slot="structured-data"
    type="itemlist"
    id={`${homepageUrl}#latest-works`}
    url={homepageUrl}
    name="Latest Works"
    items={toItemListItems(selectedWorks)}
  />

  <!-- Hero Section -->
  <Section
    spacing="none"
    class="relative min-h-screen md:-mt-24 md:pt-24 flex items-center overflow-hidden"
  >
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <Grainient
        client:load
        color1="var(--color-brand-200-hex)"
        darkColor1="var(--color-brand-700-hex)"
        color2="var(--color-brand-500-hex)"
        darkColor2="var(--color-brand-800-hex)"
        color3="var(--color-accent-400-hex)"
        timeSpeed={1.0}
        colorBalance={0.0}
        warpStrength={1.0}
        warpFrequency={5.0}
        warpSpeed={2.0}
        warpAmplitude={50.0}
        blendAngle={0.0}
        blendSoftness={0.05}
        rotationAmount={500.0}
        noiseScale={2.0}
        grainAmount={0.1}
        grainScale={2.0}
        grainAnimated={true}
        contrast={1.5}
        gamma={1.0}
        saturation={1.0}
        centerX={0.0}
        centerY={0.0}
        zoom={1.75}
        overlayClassName="bg-bg-base/18 dark:bg-bg-base/24"
      />
    </div>

    <Container size="lg" class="relative z-10">
      <div class="max-w-[var(--container-4xl)] mx-auto text-center">
        <h1 class="text-7xl font-bold leading-tight mb-m text-text-primary">
          Hi,<br class="md:hidden" /> I'm Jet Sanchez.
        </h1>
        <p class="text-base text-text-secondary mb-l">
          Research, systems & tools for thinking clearly in an AI-driven world
        </p>
        <div class="flex flex-wrap gap-s justify-center">
          <Button href="/about/" variant="primary" density="immersive"
            >About me</Button
          >
          <Button href="/contact/" variant="accent" density="immersive"
            >Get in touch</Button
          >
        </div>
      </div>
    </Container>
  </Section>

  <div data-home-reveal-scope>
    <!-- Latest Blog Posts -->
    <Section spacing="default" background="subtle">
      <Container size="lg">
        <div
          class="mb-l flex flex-col items-center gap-2xs text-center"
          data-home-reveal="text"
        >
          <h2 class="text-3xl font-bold leading-tight text-text-primary">
            Latest Articles
          </h2>
          <Button href="/blog/" variant="ghost"
            ><span>View all <span class="text-accent-base">→</span></span
            ></Button
          >
        </div>

        <div data-home-reveal="component">
          {
            latestPosts.length > 0 ? (
              <HomeCollectionCarousel
                label="Latest Articles"
                items={latestPosts}
              />
            ) : (
              <Card>
                <p class="text-center text-text-tertiary py-l">
                  No blog posts yet. Check back soon!
                </p>
              </Card>
            )
          }
        </div>
      </Container>
    </Section>

    <!-- Latest Works -->
    <Section spacing="default">
      <Container size="lg">
        <div
          class="mb-l flex flex-col items-center gap-2xs text-center"
          data-home-reveal="text"
        >
          <h2 class="text-3xl font-bold leading-tight text-text-primary">
            Latest Works
          </h2>
          <Button href="/works/" variant="ghost"
            ><span>View all <span class="text-accent-base">→</span></span
            ></Button
          >
        </div>

        <div data-home-reveal="component">
          {
            selectedWorks.length > 0 ? (
              <HomeCollectionCarousel
                label="Latest Works"
                items={selectedWorks}
              />
            ) : (
              <Card>
                <p class="text-center text-text-tertiary py-l">
                  No selected works yet. Check back soon!
                </p>
              </Card>
            )
          }
        </div>
      </Container>
    </Section>

    <!-- Call to Action -->
    <Section spacing="default" background="brand">
      <Container size="md">
        <div class="text-center">
          <h2
            class="text-3xl font-bold mb-s text-text-primary"
            data-home-reveal="text"
            data-home-reveal-group="cta"
            data-home-reveal-order="0"
          >
            Let's Connect
          </h2>
          <p
            class="text-lg text-text-secondary mb-l"
            data-home-reveal="text"
            data-home-reveal-group="cta"
            data-home-reveal-order="1"
          >
            Interested in collaborating or have questions? Feel free to reach
            out!
          </p>
          <div
            class="flex flex-wrap justify-center gap-s"
            data-home-reveal="component"
            data-home-reveal-group="cta"
            data-home-reveal-order="2"
          >
            <Button href="/contact/" variant="accent" density="immersive"
              >Contact me</Button
            >
            <Button href="/about/" variant="brand" density="immersive"
              >Learn more</Button
            >
          </div>
        </div>
      </Container>
    </Section>
  </div>

  <script>
    import { installHomeRevealController } from '../features/home-reveal/homeRevealController';

    installHomeRevealController(document);
  </script>
</BaseLayout>
