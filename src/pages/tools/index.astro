---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageWrapper from '../../components/layout/PageWrapper.astro';
import Container from '../../components/ui/Container.astro';
---

<BaseLayout
  title="Tools"
  description="A reserved space for future standalone tools from Jet Sanchez."
  noindex={true}
>
  <PageWrapper spacing="default">
    <Container size="md">
      <h1 class="mb-s text-5xl font-bold leading-tight text-text-primary">
        Tools
      </h1>
      <p
        class="max-w-[var(--container-2xl)] text-xl leading-relaxed text-text-tertiary"
      >
        This section is reserved for future standalone utilities. It will remain
        dormant until there are enough useful tools to justify a dedicated
        collection.
      </p>
    </Container>
  </PageWrapper>
</BaseLayout>
