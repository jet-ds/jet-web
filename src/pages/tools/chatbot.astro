---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import JetsGhostExperience from '../../features/jets-ghost/JetsGhostExperience';

const title = "Jet's Ghost — Local AI Interface Preview";
const description = "Preview the full-screen, local-first chat experience planned for Jet's Ghost 2.1.";
---

<BaseLayout title={title} description={description} noindex={true} immersive>
  <JetsGhostExperience client:load />
</BaseLayout>

<style is:global>
  .jets-ghost-header {
    padding-top: max(var(--space-m), env(safe-area-inset-top));
  }

  .jets-ghost-composer {
    padding-bottom: calc(var(--space-2xl) + var(--space-xl) + env(safe-area-inset-bottom));
  }

  @media (min-width: 769px) {
    .jets-ghost-header {
      padding-top: calc(var(--space-2xl) + var(--space-xl));
    }

    .jets-ghost-composer {
      padding-bottom: var(--space-m);
    }
  }
</style>
