---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageWrapper from '../../components/layout/PageWrapper.astro';
import Container from '../../components/ui/Container.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogSearchEnhancement from '../../components/blog/BlogSearchEnhancement.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { SITE } from '../../config/site';
import { resolveBlogCollection } from '../../features/collections/resolveCollections';
import type { SearchableBlogRecord } from '../../features/blog-search/searchBlogPosts';

const sortedPosts = resolveBlogCollection(await getCollection('blog'));
const searchRecords: SearchableBlogRecord[] = sortedPosts.map((post) => {
  if (!post.search) {
    throw new Error(`Blog display record ${post.id} is missing search fields.`);
  }
  return {
    id: post.id,
    title: post.search.title,
    shortTitle: post.search.shortTitle,
    description: post.search.description,
    summary: post.search.summary,
    tags: post.search.tags,
    pubDate: post.date,
  };
});
const pageDescription =
  "Explore Jet Sanchez's articles on AI, agentic software development, local-first tools, technical workflows, and the systems shaping modern work.";
const pageSubheading =
  'Explore my articles on AI, agentic software development, local-first tools, technical workflows, and the systems shaping modern work.';
const blogUrl = new URL('/blog/', SITE.siteUrl).toString();
const blogItems = sortedPosts.map((post) => {
  const url = new URL(post.href, SITE.siteUrl).toString();
  return { url, entityId: `${url}#blogposting` };
});
---

<BaseLayout title="Blog" description={pageDescription}>
  <StructuredData
    slot="structured-data"
    type="itemlist"
    id={`${blogUrl}#blog-posts`}
    url={blogUrl}
    name="Blog Posts"
    items={blogItems}
  />

  <PageWrapper spacing="compact">
    <Container size="lg">
      <div data-blog-search>
        <div class="mb-xl">
          <h1 class="text-5xl font-bold leading-tight mb-s">Blog</h1>
          <p class="text-xl text-text-tertiary max-w-[var(--container-2xl)]">
            {pageSubheading}
          </p>
        </div>

        {
          searchRecords.length > 0 && (
            <section data-blog-search-enhancement hidden class="mb-l">
              <form role="search" class="max-w-[var(--container-xl)]">
                <label
                  for="blog-search-input"
                  class="block text-base font-semibold text-text-primary mb-2xs"
                >
                  Search blog posts
                </label>
                <div class="flex flex-col gap-2xs sm:flex-row">
                  <div class="relative min-w-0 flex-1">
                    <svg
                      data-blog-search-icon
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="pointer-events-none absolute left-s top-1/2 size-5 -translate-y-1/2 text-text-tertiary"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input
                      id="blog-search-input"
                      data-blog-search-input
                      type="search"
                      name="q"
                      autocomplete="off"
                      aria-describedby="blog-search-instruction"
                      class="min-h-11 w-full min-w-0 rounded-lg border border-border-default bg-surface-base py-2xs pr-s pl-xl text-text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-base"
                    />
                  </div>
                  <button
                    type="button"
                    data-blog-search-clear
                    data-action-variant="neutral"
                    data-action-density="default"
                    hidden
                    class="action action--neutral action--default px-s"
                  >
                    Clear search
                  </button>
                </div>
                <p id="blog-search-instruction" class="sr-only">
                  Search titles, summaries, and topics. Results update as you
                  type.
                </p>
              </form>
              <p
                data-blog-search-status
                role="status"
                aria-live="polite"
                aria-atomic="true"
                class="mt-s text-sm text-text-tertiary"
              >
                {searchRecords.length}{' '}
                {searchRecords.length === 1 ? 'post' : 'posts'}
              </p>
            </section>
          )
        }

        {
          sortedPosts.length > 0 ? (
            <div
              data-blog-search-list
              class="grid grid-cols-1 gap-l md:grid-cols-2"
            >
              {sortedPosts.map((post) => (
                <div
                  data-blog-search-item
                  data-blog-search-id={post.id}
                  class="h-full"
                >
                  <BlogCard headingLevel={2} record={post} />
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-xl">
              <p class="text-text-tertiary text-lg">
                No blog posts yet. Check back soon!
              </p>
            </div>
          )
        }

        <div data-blog-search-empty hidden class="text-center py-xl">
          <p class="text-text-tertiary text-lg">
            No posts match your search. Try a different title, summary, or
            topic.
          </p>
        </div>

        {
          searchRecords.length > 0 && (
            <BlogSearchEnhancement records={searchRecords} />
          )
        }
      </div>
    </Container>
  </PageWrapper>
</BaseLayout>
