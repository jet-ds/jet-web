---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageWrapper from '../../components/layout/PageWrapper.astro';
import Container from '../../components/ui/Container.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CollectionFilterEnhancement from '../../components/filters/CollectionFilterEnhancement.astro';
import { isPublished } from '../../content/policy';
import { sortBlogPosts } from '../../utils/sortByDate';
import { getAllTags, getTagCounts } from '../../utils/filterByTag';

const allPosts = await getCollection('blog', ({ data }) => isPublished(data));
const sortedPosts = sortBlogPosts(allPosts);
const allTags = getAllTags(sortedPosts);
const tagCounts = getTagCounts(sortedPosts);
const pageDescription =
  "Explore Jet Sanchez's articles on AI, agentic software development, local-first tools, technical workflows, and the systems shaping modern work.";
const pageSubheading =
  'Explore my articles on AI, agentic software development, local-first tools, technical workflows, and the systems shaping modern work.';
---

<BaseLayout title="Blog" description={pageDescription}>
  <PageWrapper spacing="compact">
    <Container size="lg">
      <div
        data-collection-filter
        data-filter-param="tag"
        data-filter-singular="post"
        data-filter-plural="posts"
        data-filter-context-template={' tagged with "{value}"'}
      >
        <div class="mb-xl">
          <h1 class="text-5xl font-bold leading-tight mb-s">Blog</h1>
          <p class="text-xl text-text-tertiary max-w-[var(--container-2xl)]">
            {pageSubheading}
          </p>
        </div>

        {
          sortedPosts.length > 0 && (
            <section
              data-filter-enhancement
              hidden
              aria-labelledby="blog-filter-heading"
              class="mb-l"
            >
              <h2
                id="blog-filter-heading"
                class="text-2xl font-bold leading-tight mb-s"
              >
                Browse by tag
              </h2>
              <div
                role="group"
                aria-label="Filter posts by tag"
                class="flex flex-wrap gap-2xs"
              >
                <button
                  type="button"
                  data-filter-value=""
                  data-action-variant="filter"
                  data-action-density="compact"
                  aria-pressed="true"
                  class="action action--filter action--compact rounded-full px-s text-sm"
                >
                  All
                  <span class="text-xs">({sortedPosts.length})</span>
                </button>
                {allTags.map((tag) => (
                  <button
                    type="button"
                    data-filter-value={tag}
                    data-action-variant="filter"
                    data-action-density="compact"
                    aria-pressed="false"
                    class="action action--filter action--compact rounded-full px-s text-sm"
                  >
                    {tag}
                    <span class="text-xs">({tagCounts[tag]})</span>
                  </button>
                ))}
              </div>
              <p
                data-filter-status
                role="status"
                aria-live="polite"
                aria-atomic="true"
                class="mt-s text-sm text-text-tertiary"
              >
                {sortedPosts.length} posts
              </p>
            </section>
          )
        }

        {
          sortedPosts.length > 0 ? (
            <div class="grid gap-l md:grid-cols-2 lg:grid-cols-2">
              {sortedPosts.map((post) => (
                <BlogCard
                  slug={post.id}
                  title={post.data.title}
                  shortTitle={post.data.shortTitle}
                  description={post.data.description}
                  summary={post.data.summary}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  image={post.data.image}
                  content={post.body}
                />
              ))}
            </div>
          ) : (
            <div class="text-center py-xl">
              <p class="text-text-tertiary text-lg">
                No blog posts yet. Check back soon!
              </p>
            </div>
          )
        }

        <div data-filter-empty hidden class="text-center py-xl">
          <p data-filter-empty-message class="text-text-tertiary text-lg"></p>
        </div>

        <CollectionFilterEnhancement />
      </div>
    </Container>
  </PageWrapper>
</BaseLayout>
