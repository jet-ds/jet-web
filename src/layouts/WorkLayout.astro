---
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Link from '../components/ui/Link.astro';
import Button from '../components/ui/Button.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { getCanonicalURL } from '../utils/seo';

export interface Props {
  title: string;
  description: string;
  type: 'research' | 'project' | 'other';
  date: Date;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
  };
  links?: { label: string; url: string }[];
  // For research
  venue?: string;
  abstract?: string;
  // For projects
  technologies?: string[];
  repository?: string;
  demo?: string;
}

const {
  title,
  description,
  type,
  date,
  tags = [],
  image,
  links = [],
  venue,
  abstract,
  technologies = [],
  repository,
  demo,
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

const typeLabel = {
  research: 'Research',
  project: 'Project',
  other: 'Work',
}[type];

const typeColor = {
  research: 'primary' as const,
  project: 'primary' as const,
  other: 'default' as const,
}[type];

const canonicalURL = getCanonicalURL(Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  image={image?.url}
  imageAlt={image?.alt}
  mainEntityId={type === 'research' ? `${canonicalURL}#scholarlyarticle` : `${canonicalURL}#creativework`}
>
  {type === 'research' ? (
    <StructuredData
      slot="structured-data"
      type="scholarlyarticle"
      id={`${canonicalURL}#scholarlyarticle`}
      url={canonicalURL}
      headline={title}
      description={description}
      abstract={abstract}
      image={image?.url}
      datePublished={date.toISOString()}
      venue={venue}
      tags={tags}
    />
  ) : (
    <StructuredData
      slot="structured-data"
      type="creativework"
      id={`${canonicalURL}#creativework`}
      url={canonicalURL}
      name={title}
      description={description}
      image={image?.url}
      datePublished={date.toISOString()}
      tags={tags}
    />
  )}
  <PageWrapper spacing="compact">
    <Container size="md">
      <article>
        <!-- Back to Works Link -->
        <div class="mb-l">
          <a href="/works" class="inline-flex items-center gap-1 transition-colors text-text-tertiary hover:text-text-secondary no-underline hover:underline">
            <span class="text-accent-base">←</span> Back to Works
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-l">
          <!-- Type Badge -->
          <div class="mb-s">
            <Tag variant={typeColor} size="md">{typeLabel}</Tag>
          </div>

          <h1 class="text-4xl font-bold leading-tight mb-s text-text-primary">
            {title}
          </h1>

          <!-- Meta Information -->
          <div class="flex flex-wrap items-center gap-s text-sm text-text-tertiary mb-m">
          <time datetime={date.toISOString()}>
            {formattedDate}
          </time>
          {venue && (
            <>
              <div>•</div>
              <div>{venue}</div>
            </>
          )}
        </div>

        <!-- Description -->
        <p class="text-lg text-text-secondary mb-m">
          {description}
        </p>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2xs mb-m">
            {tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )}

        <!-- Technologies (for projects) -->
        {technologies.length > 0 && (
          <div class="mb-m">
            <h3 class="text-sm font-semibold mb-2xs text-text-primary">
              Technologies
            </h3>
            <div class="flex flex-wrap gap-2xs">
              {technologies.map((tech) => (
                <Tag>{tech}</Tag>
              ))}
            </div>
          </div>
        )}

        <!-- Links -->
        {(links.length > 0 || repository || demo) && (
          <div class="flex flex-wrap gap-xs">
            {links.map((link) => (
              <Button
                href={link.url}
                variant="accent"
                size="sm"
              >
                {link.label}
              </Button>
            ))}
            {repository && (
              <Button
                href={repository}
                variant="outline"
                size="sm"
              >
                View Repository
              </Button>
            )}
            {demo && (
              <Button
                href={demo}
                variant="secondary"
                size="sm"
              >
                Live Demo
              </Button>
            )}
          </div>
        )}
        </header>

        <!-- Featured Image -->
        {image && (
          <div class="aspect-video overflow-hidden rounded-lg mb-l">
            <OptimizedImage
              src={image.url}
              alt={image.alt}
              width={1920}
              height={1080}
              class="w-full h-full object-cover"
              loading="eager"
              sizes="(max-width: 768px) 100vw, 800px"
            />
          </div>
        )}

        <!-- Work Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>
      </article>
    </Container>
  </PageWrapper>
</BaseLayout>
