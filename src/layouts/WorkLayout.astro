---
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Button from '../components/ui/Button.astro';
import ThemeAwareImage from '../components/ui/ThemeAwareImage.astro';
import { getCanonicalURL } from '../utils/seo';

export interface Props {
  title: string;
  seoTitle?: string;
  seoDescription?: string;
  description: string;
  type: 'research' | 'project' | 'other';
  date: Date;
  tags?: string[];
  image?: {
    url: string;
    darkUrl?: string;
    alt: string;
    width?: number;
    height?: number;
  };
  links?: { label: string; url: string }[];
  // For research
  venue?: string;
  abstract?: string;
  // For projects
  repository?: string;
  demo?: string;
}

const {
  title,
  seoTitle,
  seoDescription,
  description,
  type,
  date,
  tags = [],
  image,
  links = [],
  venue,
  abstract,
  repository,
  demo,
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

const typeLabel = {
  research: 'Research',
  project: 'Project',
  other: 'Work',
}[type];

const typeColor = {
  research: 'primary' as const,
  project: 'primary' as const,
  other: 'default' as const,
}[type];

const canonicalURL = getCanonicalURL(Astro.url.pathname);
const doiUrl =
  type === 'research'
    ? links.find(
        ({ url }) =>
          url.startsWith('https://doi.org/') ||
          url.startsWith('https://dx.doi.org/'),
      )?.url
    : undefined;
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  image={image?.url}
  imageAlt={image?.alt}
  imageWidth={image?.width}
  imageHeight={image?.height}
  type={type === 'research' ? 'article' : 'website'}
  publishedTime={type === 'research' ? date.toISOString() : undefined}
  tags={type === 'research' ? tags : undefined}
  mainEntityId={type === 'research'
    ? `${canonicalURL}#scholarlyarticle`
    : `${canonicalURL}#creativework`}
>
  {
    type === 'research' ? (
      <StructuredData
        slot="structured-data"
        type="scholarlyarticle"
        id={`${canonicalURL}#scholarlyarticle`}
        url={canonicalURL}
        headline={title}
        description={description}
        abstract={abstract}
        image={image?.url}
        datePublished={date.toISOString()}
        venue={venue}
        identifier={doiUrl}
        sameAs={doiUrl ? [doiUrl] : undefined}
        tags={tags}
      />
    ) : (
      <StructuredData
        slot="structured-data"
        type="creativework"
        id={`${canonicalURL}#creativework`}
        url={canonicalURL}
        name={title}
        description={description}
        image={image?.url}
        datePublished={date.toISOString()}
        tags={tags}
      />
    )
  }
  <PageWrapper spacing="compact">
    <Container size="md">
      <article>
        <!-- Back to works link -->
        <div class="mb-l">
          <a href="/works/" class="text-link inline-flex items-center gap-1">
            <span class="text-accent-base">←</span> Back to works
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-l">
          <!-- Type Badge -->
          <div class="mb-s">
            <Tag variant={typeColor} size="md">{typeLabel}</Tag>
          </div>

          <h1 class="text-4xl font-bold leading-tight mb-s text-text-primary">
            {title}
          </h1>

          <!-- Meta Information -->
          <div
            class="flex flex-wrap items-center gap-s text-sm text-text-tertiary mb-m"
          >
            <time datetime={date.toISOString()}>
              {formattedDate}
            </time>
            {
              venue && (
                <>
                  <div>•</div>
                  <div>{venue}</div>
                </>
              )
            }
          </div>

          <!-- Description -->
          <p class="text-lg text-text-secondary mb-m">
            {description}
          </p>

          <!-- Tags -->
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-2xs mb-m">
                {tags.map((tag) => (
                  <Tag>{tag}</Tag>
                ))}
              </div>
            )
          }

          <!-- Links -->
          {
            (links.length > 0 || repository || demo) && (
              <div class="flex flex-wrap gap-xs">
                {links.map((link) => (
                  <Button href={link.url} variant="accent" density="compact">
                    {link.label}
                  </Button>
                ))}
                {repository && (
                  <Button href={repository} variant="outline" density="compact">
                    View repository
                  </Button>
                )}
                {demo && (
                  <Button href={demo} variant="secondary" density="compact">
                    Live demo
                  </Button>
                )}
              </div>
            )
          }
        </header>

        <!-- Featured Image -->
        {
          image && (
            <div class="aspect-video overflow-hidden rounded-lg mb-l">
              <ThemeAwareImage
                src={image.url}
                darkSrc={image.darkUrl}
                alt={image.alt}
                width={image.width ?? 1920}
                height={image.height ?? 1080}
                class="w-full h-full object-cover"
                loading="eager"
                sizes="(max-width: 768px) 100vw, 800px"
              />
            </div>
          )
        }

        <!-- Work Content -->
        <slot />
      </article>
    </Container>
  </PageWrapper>
</BaseLayout>
