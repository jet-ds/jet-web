---
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { getCanonicalURL } from '../utils/seo';
import type { BlogFrontmatter } from '../schemas/content';

export interface Props {
  title: string;
  seoTitle?: string;
  seoDescription?: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
    width: number;
    height: number;
  };
  readingTime?: number;
  review?: BlogFrontmatter['review'];
}

const {
  title,
  seoTitle,
  seoDescription,
  description,
  pubDate,
  updatedDate,
  author,
  tags = [],
  image,
  readingTime,
  review,
} = Astro.props;

const formattedPubDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const canonicalURL = getCanonicalURL(Astro.url.pathname);
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  image={image?.url}
  imageAlt={image?.alt}
  imageWidth={image?.width}
  imageHeight={image?.height}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  author={author}
  tags={tags}
  mainEntityId={`${canonicalURL}#blogposting`}
>
  <StructuredData
    slot="structured-data"
    type="blogposting"
    id={`${canonicalURL}#blogposting`}
    url={canonicalURL}
    headline={title}
    description={description}
    image={image?.url}
    datePublished={pubDate.toISOString()}
    dateModified={updatedDate?.toISOString()}
    author={author}
    tags={tags}
  />
  {
    review && (
      <StructuredData
        slot="structured-data"
        type="review"
        id={`${canonicalURL}#review`}
        url={canonicalURL}
        name={`${review.itemName} review by ${author}`}
        itemType="Movie"
        itemName={review.itemName}
        ratingValue={review.ratingValue}
        bestRating={review.bestRating}
        datePublished={pubDate.toISOString()}
        dateModified={updatedDate?.toISOString()}
        author={author}
        isPartOfId={`${canonicalURL}#blogposting`}
      />
    )
  }
  <PageWrapper spacing="compact">
    <Container size="md">
      <article>
        <!-- Back to blog link -->
        <div class="mb-l">
          <a href="/blog/" class="text-link inline-flex items-center gap-1">
            <span class="text-accent-base">←</span> Back to blog
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-l">
          <h1 class="text-5xl font-bold leading-tight mb-s text-text-primary">
            {title}
          </h1>

          <!-- Meta Information -->
          <div
            class="flex flex-wrap items-center gap-s text-sm text-text-tertiary mb-m"
          >
            <div>
              <span class="font-medium">By {author}</span>
            </div>
            <div>•</div>
            <time datetime={pubDate.toISOString()}>
              {formattedPubDate}
            </time>
            {
              formattedUpdatedDate && (
                <>
                  <div>•</div>
                  <div>Updated: {formattedUpdatedDate}</div>
                </>
              )
            }
            {
              readingTime && (
                <>
                  <div>•</div>
                  <div>{readingTime} min read</div>
                </>
              )
            }
          </div>

          {
            review && (
              <div
                class="mb-m flex flex-wrap items-center gap-2xs text-sm text-text-secondary"
                aria-label={`Jet’s rating: ${review.ratingValue} out of ${review.bestRating} stars`}
              >
                <span
                  class="tracking-wider text-accent-base"
                  aria-hidden="true"
                >
                  {Array.from({ length: review.bestRating }, (_, index) =>
                    index < review.ratingValue ? '★' : '☆',
                  ).join('')}
                </span>
                <span class="font-medium">
                  {review.ratingValue}/{review.bestRating}
                </span>
              </div>
            )
          }

          <!-- Tags -->
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-2xs">
                {tags.map((tag) => (
                  <Tag variant="primary">{tag}</Tag>
                ))}
              </div>
            )
          }
        </header>

        <!-- Featured Image -->
        {
          image && (
            <div class="aspect-video overflow-hidden rounded-lg mb-l">
              <OptimizedImage
                src={image.url}
                alt={image.alt}
                width={image.width}
                height={image.height}
                class="w-full h-full object-cover"
                loading="eager"
                sizes="(max-width: 768px) 100vw, 800px"
              />
            </div>
          )
        }

        <!-- Article Content -->
        <slot />
      </article>
    </Container>
  </PageWrapper>
</BaseLayout>
