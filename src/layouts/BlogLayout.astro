---
import BaseLayout from '../components/layout/BaseLayout.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import PageWrapper from '../components/layout/PageWrapper.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import Link from '../components/ui/Link.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import { getCanonicalURL } from '../utils/seo';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags?: string[];
  image?: {
    url: string;
    alt: string;
  };
  readingTime?: number;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  tags = [],
  image,
  readingTime,
} = Astro.props;

const formattedPubDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const canonicalURL = getCanonicalURL(Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  image={image?.url}
  imageAlt={image?.alt}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  author={author}
  tags={tags}
  mainEntityId={`${canonicalURL}#blogposting`}
>
  <StructuredData
    slot="structured-data"
    type="blogposting"
    id={`${canonicalURL}#blogposting`}
    url={canonicalURL}
    headline={title}
    description={description}
    image={image?.url}
    datePublished={pubDate.toISOString()}
    dateModified={updatedDate?.toISOString()}
    author={author}
    tags={tags}
  />
  <PageWrapper spacing="compact">
    <Container size="md">
      <article>
        <!-- Back to Blog Link -->
        <div class="mb-l">
          <a href="/blog" class="inline-flex items-center gap-1 transition-colors text-text-tertiary hover:text-text-secondary no-underline hover:underline">
            <span class="text-accent-base">←</span> Back to Blog
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-l">
          <h1 class="text-5xl font-bold leading-tight mb-s text-text-primary">
            {title}
          </h1>

          <!-- Meta Information -->
          <div class="flex flex-wrap items-center gap-s text-sm text-text-tertiary mb-m">
          <div>
            <span class="font-medium">By {author}</span>
          </div>
          <div>•</div>
          <time datetime={pubDate.toISOString()}>
            {formattedPubDate}
          </time>
          {formattedUpdatedDate && (
            <>
              <div>•</div>
              <div>
                Updated: {formattedUpdatedDate}
              </div>
            </>
          )}
          {readingTime && (
            <>
              <div>•</div>
              <div>
                {readingTime} min read
              </div>
            </>
          )}
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2xs">
            {tags.map((tag) => (
              <Tag variant="primary">{tag}</Tag>
            ))}
          </div>
        )}
        </header>

        <!-- Featured Image -->
        {image && (
          <div class="aspect-video overflow-hidden rounded-lg mb-l">
            <OptimizedImage
              src={image.url}
              alt={image.alt}
              width={1920}
              height={1080}
              class="w-full h-full object-cover"
              loading="eager"
              sizes="(max-width: 768px) 100vw, 800px"
            />
          </div>
        )}

        <!-- Article Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>
      </article>
    </Container>
  </PageWrapper>
</BaseLayout>
