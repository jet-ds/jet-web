---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  widths?: number[];
  quality?: number;
  aspectRatio?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  sizes,
  widths,
  quality = 80,
  aspectRatio,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  {...sizes && { sizes }}
  {...widths && { widths }}
  quality={quality}
  {...aspectRatio && { 'data-aspect': aspectRatio }}
/>
