---
interface Props {
  src: string;
  srcSet?: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  aspectRatio?: string;
}

const {
  src,
  srcSet,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  sizes,
  aspectRatio,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  {...sizes && { sizes }}
  srcset={srcSet}
  decoding="async"
  {...aspectRatio && { 'data-aspect': aspectRatio }}
/>
