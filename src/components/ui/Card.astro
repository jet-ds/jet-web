---
export interface Props {
  class?: string;
  clip?: boolean;
  href?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  radius?: 'lg' | 'xl';
  surface?: 'base' | 'subtle';
  hover?: boolean;
}

const {
  class: className = '',
  clip = false,
  href,
  padding,
  radius,
  surface = 'base',
  hover = false,
  ...rest
} = Astro.props;

const baseClasses = 'border border-border-default transition-colors';

const surfaceClasses = {
  base: 'bg-surface-base',
  subtle: 'bg-bg-subtle',
};

const resolvedPadding = padding ?? (surface === 'subtle' ? 'lg' : 'md');
const resolvedRadius = radius ?? (surface === 'subtle' ? 'xl' : 'lg');

const radiusClasses = {
  lg: 'rounded-lg',
  xl: 'rounded-xl',
};

const paddingClasses = {
  none: '',
  sm: 'p-s',
  md: 'p-m',
  lg: 'p-card',
};
const rootPaddingClass = href ? '' : paddingClasses[resolvedPadding];
const linkedPaddingClass = href ? paddingClasses[resolvedPadding] : '';

const interactive = hover || Boolean(href);
const hoverClasses = interactive
  ? 'hover:border-brand-base hover:shadow-md cursor-pointer'
  : '';
const clipClass = clip ? 'overflow-hidden' : '';
const clippedFocusClass =
  clip && interactive
    ? 'has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-base'
    : '';
const linkedFocusClass =
  href && !clip
    ? 'has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-base'
    : '';
const linkedLayoutClass = href ? '[&:not([hidden])]:flex flex-col' : '';

const classes = `${surfaceClasses[surface]} ${radiusClasses[resolvedRadius]} ${baseClasses} ${rootPaddingClass} ${hoverClasses} ${clipClass} ${clippedFocusClass} ${linkedFocusClass} ${linkedLayoutClass} ${className}`;
---

<div class={classes} {...rest}>
  {
    href ? (
      <a
        href={href}
        class={`${linkedPaddingClass} flex flex-1 flex-col group focus-visible:outline-none`}
      >
        <slot />
      </a>
    ) : (
      <slot />
    )
  }
  <slot name="actions" />
</div>
