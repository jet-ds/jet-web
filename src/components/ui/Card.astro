---
export interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  surface?: 'base' | 'subtle';
  hover?: boolean;
}

const {
  class: className = '',
  padding = 'md',
  surface = 'base',
  hover = false,
  ...rest
} = Astro.props;

const baseClasses = 'border border-border-default rounded-lg transition-colors';

const surfaceClasses = {
  base: 'bg-surface-base',
  subtle: 'bg-bg-subtle',
};

const paddingClasses = {
  none: '',
  sm: 'p-s',
  md: 'p-m',
  lg: 'p-card',
};

const hoverClasses = hover
  ? 'hover:border-brand-base hover:shadow-md cursor-pointer'
  : '';

const classes = `${surfaceClasses[surface]} ${baseClasses} ${paddingClasses[padding]} ${hoverClasses} ${className}`;
---

<div class={classes} {...rest}>
  <slot />
</div>
