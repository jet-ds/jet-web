---
export interface Props {
  variant?: 'primary' | 'accent' | 'brand' | 'secondary' | 'outline' | 'ghost' | 'filter';
  density?: 'compact' | 'default' | 'immersive';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  external?: boolean;
}

const {
  variant = 'primary',
  density = 'default',
  href,
  class: className = '',
  type = 'button',
  external = false,
  ...rest
} = Astro.props;

const actionVariant = {
  primary: 'brand',
  accent: 'accent',
  brand: 'soft',
  secondary: 'neutral',
  outline: 'outline',
  ghost: 'ghost',
  filter: 'filter',
} as const;

const actionVariantClasses = {
  primary: 'action--brand',
  accent: 'action--accent',
  brand: 'action--soft',
  secondary: 'action--neutral',
  outline: 'action--outline',
  ghost: 'action--ghost',
  filter: 'action--filter',
};

const densityClasses = {
  compact: 'action--compact',
  default: 'action--default',
  immersive: 'action--immersive',
};

const densityTextClasses = {
  compact: 'text-sm',
  default: 'text-base',
  immersive: 'text-lg',
};

const resolvedVariant = actionVariant[variant];
const classes = `action ${actionVariantClasses[variant]} ${densityClasses[density]} ${densityTextClasses[density]} ${className}`;

const Element = href ? 'a' : 'button';
const elementProps = href ? { href } : { type };
const externalProps = href && external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Element
  {...elementProps}
  {...externalProps}
  {...rest}
  class={classes}
  data-action-variant={resolvedVariant}
  data-action-density={density}
>
  <slot />
</Element>
