---
export interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  gutter?: boolean;
  class?: string;
}

const {
  size = 'lg',
  gutter = true,
  class: className = '',
  ...rest
} = Astro.props;

const baseClasses = gutter ? 'mx-auto px-gutter' : 'mx-auto';

const sizeClasses = {
  sm: 'max-w-[var(--container-2xl)]',
  md: 'max-w-[var(--container-4xl)]',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  full: 'max-w-full',
};

const classes = `${baseClasses} ${sizeClasses[size]} ${className}`;
---

<div class={classes} {...rest}>
  <slot />
</div>
