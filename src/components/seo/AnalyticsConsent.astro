---
import { shouldEmitProductionAnalytics } from '../../features/analytics/trackingPolicy';

const enabled = shouldEmitProductionAnalytics({
  vercelEnv: process.env.VERCEL_ENV,
});
---

{
  enabled && (
    <aside
      id="analytics-consent"
      data-analytics-consent-panel
      hidden
      role="region"
      aria-label="Analytics choices"
      class="analytics-consent-panel fixed bottom-gutter z-[70] rounded-lg border border-border-strong bg-bg-base p-card shadow-xl"
    >
      <div class="flex flex-col gap-s sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-relaxed text-text-secondary">
          Analytics helps me understand which pages are useful. You can allow or
          reject it, and change your choice later from the Privacy page.
        </p>
        <div class="flex min-w-0 shrink-0 flex-wrap gap-xs">
          <button
            type="button"
            data-analytics-choice="reject"
            class="action action--outline action--compact flex-1 sm:flex-none"
          >
            Reject analytics
          </button>
          <button
            type="button"
            data-analytics-choice="allow"
            class="action action--outline action--compact flex-1 sm:flex-none"
          >
            Allow analytics
          </button>
          <button
            type="button"
            data-analytics-close
            hidden
            class="action action--ghost action--compact w-full"
          >
            Close analytics settings
          </button>
        </div>
      </div>
    </aside>
  )
}

<style>
  .analytics-consent-panel {
    left: 50%;
    width: calc(100% - var(--space-gutter) - var(--space-gutter));
    max-width: var(--container-2xl);
    transform: translateX(-50%);
  }

  [data-analytics-consent-panel][hidden] {
    display: none;
  }

  [data-analytics-close][hidden] {
    display: none;
  }
</style>
