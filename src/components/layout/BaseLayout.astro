---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../ui/ThemeScript.astro';
import SEO from '../seo/SEO.astro';
import StructuredData from '../seo/StructuredData.astro';
import GoogleAnalytics from '../seo/GoogleAnalytics.astro';
import DockWrapper from '../navigation/DockWrapper.astro';
import Footer from './Footer.astro';
import { NAV_ITEMS, SITE } from '../../config/site';
import { generateSEOProps, getCanonicalURL } from '../../utils/seo';
import '../../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  mainEntityId?: string; // @id of the content entity (BlogPosting, ScholarlyArticle, etc.)
  suppressWebPage?: boolean; // Set to true for homepage (which uses WebSite instead)
  noindex?: boolean; // Set to true for pages that should not be indexed (e.g. under-construction)
  immersive?: boolean; // Full-viewport tool/app shell; keeps the dock and omits site chrome
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonicalURL,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  mainEntityId,
  suppressWebPage = false,
  noindex = false,
  immersive = false,
} = Astro.props;

// Generate SEO props with defaults
const seoProps = generateSEOProps({
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonicalURL: canonicalURL || getCanonicalURL(Astro.url.pathname),
  type,
  publishedTime,
  modifiedTime,
  author,
  tags,
});

const navigationElements = NAV_ITEMS.map((item) => ({
  name: item.label,
  url: new URL(item.href, SITE.siteUrl).toString(),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine Optimization -->
    <SEO {...seoProps} noindex={noindex} />

    <!-- WebPage Schema -->
    {!suppressWebPage && (
      <StructuredData
        type="webpage"
        id={`${seoProps.canonicalURL}#webpage`}
        url={seoProps.canonicalURL}
        name={seoProps.title}
        description={seoProps.description}
        image={seoProps.image}
        mainEntityId={mainEntityId}
      />
    )}

    <!-- Content Schema -->
    <slot name="structured-data" />

    <!-- Site Navigation -->
    <StructuredData
      type="navigation"
      navigationElements={navigationElements}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Brawler:wght@400;700&family=Work+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Site Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- Theme -->
    <ThemeScript />

    <!-- Analytics -->
    <GoogleAnalytics measurementId={SITE.ga4MeasurementId} />

    <!-- Page Transitions -->
    <ClientRouter />
  </head>
  <body class:list={["min-h-screen flex flex-col", { "overflow-hidden": immersive }]}>
    <DockWrapper />

    <noscript>
      <nav class="fixed top-0 left-0 right-0 z-50 bg-surface-base/90 backdrop-blur-sm border-b border-border-default">
        <div class="max-w-7xl mx-auto px-4 py-4">
          <ul class="flex flex-wrap items-center justify-center gap-6">
            {NAV_ITEMS.map((item) => (
              <li>
                <a href={item.href} class="text-text-primary hover:text-brand-base">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </noscript>

    <main class:list={["flex-1", immersive ? "min-h-0" : "pt-0 md:pt-24"]}>
      <slot />
    </main>
    {!immersive && <Footer />}
  </body>
</html>
