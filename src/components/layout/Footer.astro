---
import { SITE, SOCIAL_LINKS } from '../../config/site';
import Container from '../ui/Container.astro';
import Link from '../ui/Link.astro';

const currentYear = new Date().getFullYear();

// Map platform keys to proper brand names
const platformNames: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  ssrn: 'SSRN',
  scholar: 'Google Scholar',
};

const socialLinksArray = Object.entries(SOCIAL_LINKS)
  .filter(([_, url]) => url)
  .map(([platform, url]) => ({
    platform: platformNames[platform],
    url,
  }));
---

<footer class="border-t border-border-default bg-bg-base">
  <Container class="py-xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-l">
      <!-- About Section -->
      <div>
        <h3 class="text-lg font-semibold mb-s text-text-primary">
          {SITE.title}
        </h3>
        <p class="text-sm text-text-tertiary">
          {SITE.description}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-s text-text-primary">
          Quick Links
        </h3>
        <ul class="space-y-2xs">
          <li>
            <Link href="/" variant="muted">Home</Link>
          </li>
          <li>
            <Link href="/about/" variant="muted">About</Link>
          </li>
          <li>
            <Link href="/blog/" variant="muted">Blog</Link>
          </li>
          <li>
            <Link href="/works/" variant="muted">Works</Link>
          </li>
          <li>
            <Link href="/contact/" variant="muted">Contact</Link>
          </li>
        </ul>
      </div>

      <!-- Social Links -->
      <div>
        <h3 class="text-lg font-semibold mb-s text-text-primary">Connect</h3>
        <ul class="space-y-2xs">
          {
            socialLinksArray.map(({ platform, url }) => (
              <li>
                <Link href={url} variant="muted" external>
                  {platform}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-l pt-l border-t border-border-default">
      <p class="text-center text-sm text-text-tertiary">
        © {currentYear}
        {SITE.author}. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
