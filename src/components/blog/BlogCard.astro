---
import type { CollectionDisplayRecord } from '../../features/collections/types';
import ContentCard from '../content/ContentCard.astro';

interface Props {
  record: CollectionDisplayRecord;
  variant?: 'collection' | 'compact';
  headingLevel?: 2 | 3;
}

const { record, variant = 'collection', headingLevel = 2 } = Astro.props;
---

<div class="h-full">
  <ContentCard
    href={record.href}
    title={record.title}
    summary={record.summary}
    image={record.image}
    facts={record.facts}
    variant={variant}
    headingLevel={headingLevel}
  />
</div>
