---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import ThemeAwareImage from '../ui/ThemeAwareImage.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  badge?: string;
  badgeVariant?: 'default' | 'primary';
  image?: {
    url: string;
    darkUrl?: string;
    alt: string;
  };
}

const {
  href,
  title,
  description,
  date,
  tags,
  badge,
  badgeVariant = 'default',
  image,
} = Astro.props;
---

<Card href={href} class="flex flex-col h-full">
  <div class="flex-1">
    {badge && (
      <div class="flex items-center gap-2xs mb-xs">
        <Tag variant={badgeVariant} size="sm">{badge}</Tag>
      </div>
    )}

    <h3 class="text-lg font-semibold leading-snug mb-2xs text-text-primary group-hover:text-brand-text transition-colors">
      {title}
    </h3>

    {image && (
      <div class="aspect-video overflow-hidden rounded-lg mb-2xs">
        <ThemeAwareImage
          src={image.url}
          darkSrc={image.darkUrl}
          alt={image.alt}
          width={800}
          height={450}
          class="w-full h-full object-cover"
          loading="lazy"
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
      </div>
    )}

    <p class="text-text-secondary mb-s line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-2xs mb-s">
      {tags.slice(0, 3).map((tag) => (
        <Tag size="sm">{tag}</Tag>
      ))}
    </div>
  </div>

  <time datetime={date.toISOString()} class="text-sm text-text-tertiary">
    {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
  </time>
</Card>
