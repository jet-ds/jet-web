---
import { formatDate } from '../../utils/formatDate';
import ContentCard from '../content/ContentCard.astro';

interface Props {
  slug: string;
  title: string;
  shortTitle?: string;
  description: string;
  summary?: string;
  type: 'research' | 'project' | 'other';
  date: Date;
  tags: string[];
  featured?: boolean;
  image?: {
    url: string;
    darkUrl?: string;
    alt: string;
    width?: number;
    height?: number;
  };
  venue?: string;
  technologies?: string[];
  links?: { label: string; url: string }[];
  variant?: 'collection' | 'compact';
}

const {
  slug,
  title,
  shortTitle,
  description,
  summary,
  type,
  date,
  tags,
  featured = false,
  image,
  venue,
  technologies,
  links = [],
  variant = 'collection',
} = Astro.props;

const workUrl = `/works/${slug}/`;
const formattedDate = formatDate(date);
const displayTitle = shortTitle ?? title;
const displaySummary = summary ?? description;
const technologyPreview = technologies?.slice(0, 3) ?? [];
const additionalTechnologyCount = Math.max(
  (technologies?.length ?? 0) - technologyPreview.length,
  0,
);

const typeVariant = {
  research: 'primary' as const,
  project: 'primary' as const,
  other: 'default' as const,
};

const typeLabel = {
  research: 'Research',
  project: 'Project',
  other: 'Other',
};
---

<ContentCard
  href={workUrl}
  title={displayTitle}
  description={displaySummary}
  tags={tags}
  variant={variant}
  headingLevel={3}
  badge={typeLabel[type]}
  badgeVariant={typeVariant[type]}
  featured={variant === 'collection' && featured}
  image={image}
  externalLinks={links}
  data-filter-item
  data-filter-values={JSON.stringify([type])}
>
  <div slot="metadata" class="space-y-2xs">
    {
      type === 'research' && venue && (
        <div class="flex items-center gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            />
          </svg>
          <span>{venue}</span>
        </div>
      )
    }

    {
      type === 'project' && technologyPreview.length > 0 && (
        <div class="flex items-start gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 mt-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
            />
          </svg>
          {additionalTechnologyCount > 0 ? (
            <span>
              <span aria-hidden="true">
                {technologyPreview.join(', ')} +{additionalTechnologyCount}
              </span>
              <span class="sr-only">
                {technologyPreview.join(', ')}, plus {additionalTechnologyCount}{' '}
                more technologies
              </span>
            </span>
          ) : (
            <span>{technologyPreview.join(', ')}</span>
          )}
        </div>
      )
    }

    <div class="flex items-center gap-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
      </svg>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
  </div>
</ContentCard>
