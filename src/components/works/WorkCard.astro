---
import type { CollectionDisplayRecord } from '../../features/collections/types';
import ContentCard from '../content/ContentCard.astro';

interface Props {
  record: CollectionDisplayRecord;
  variant?: 'collection' | 'compact';
  headingLevel?: 2 | 3;
}

const { record, variant = 'collection', headingLevel = 2 } = Astro.props;

const typeLabel = {
  research: 'Research',
  project: 'Project',
  other: 'Work',
} as const;

const eyebrow = record.kind === 'blog' ? undefined : typeLabel[record.kind];
---

<div
  class="h-full"
  data-filter-item
  data-filter-values={JSON.stringify([record.kind])}
>
  <ContentCard
    href={record.href}
    title={record.title}
    summary={record.summary}
    image={record.image}
    eyebrow={eyebrow}
    facts={record.facts}
    variant={variant}
    headingLevel={headingLevel}
  />
</div>
