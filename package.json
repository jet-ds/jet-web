{
  "name": "jet-web",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:browser": "playwright test",
    "verify:production": "playwright test --config=playwright.production.config.ts",
    "verify:all": "npm run verify && npm run verify:browser",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:docs": "tsx scripts/verify-doc-links.ts",
    "build": "npm run verify:content && astro build",
    "verify": "npm run check && npm run test && npm run verify:docs && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "upload-image": "tsx scripts/upload-image.ts",
    "capture:og": "tsx scripts/capture-og-image.ts",
    "validate-images": "tsx scripts/validate-images.ts",
    "verify:build-purity": "tsx scripts/verify-build-purity.ts",
    "test:jets-ghost-design": "tsx --test tests/jets-ghost-experience.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.4.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.0.0",
    "astro": "^5.16.6",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "ogl": "^1.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
