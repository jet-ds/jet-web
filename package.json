{
  "name": "jet-web",
  "type": "module",
  "version": "2.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qualify:egregore:mac": "cross-env PLAYWRIGHT_NO_COPY_PROMPT=1 RUN_REAL_MODEL=1 EGREGORE_REAL_MODEL_MODE=qualification playwright test --config=playwright.real-model.config.ts --project=chrome-real-model",
    "smoke:egregore": "cross-env PLAYWRIGHT_NO_COPY_PROMPT=1 RUN_REAL_MODEL=1 EGREGORE_REAL_MODEL_MODE=smoke playwright test --config=playwright.real-model.config.ts --project=chrome-real-model",
    "verify:browser": "playwright test",
    "verify:production": "playwright test --config=playwright.production.config.ts",
    "verify:all": "npm run verify && npm run verify:browser",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:docs": "tsx scripts/verify-doc-links.ts",
    "build": "npm run verify:content && astro build",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run verify:docs && npm run build && npm run verify:production-artifacts",
    "preview": "astro preview",
    "astro": "astro",
    "upload-image": "tsx scripts/upload-image.ts",
    "capture:og": "tsx scripts/capture-og-image.ts",
    "validate-images": "tsx scripts/validate-images.ts",
    "verify:build-purity": "tsx scripts/verify-build-purity.ts",
    "verify:production-artifacts": "tsx scripts/verify-production-artifacts.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/partytown": "2.1.7",
    "@astrojs/react": "6.0.1",
    "@litert-lm/core": "0.14.0",
    "@vercel/blob": "2.6.1",
    "astro": "7.1.3",
    "dotenv": "17.4.2",
    "framer-motion": "12.42.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "1.25.0",
    "minisearch": "7.2.0",
    "ogl": "^1.0.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "stemmer": "2.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.71",
    "cross-env": "10.1.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
