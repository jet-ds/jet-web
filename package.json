{
  "name": "jet-web",
  "type": "module",
  "version": "2.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qualify:jets-ghost:mac": "cross-env RUN_REAL_MODEL=1 JETS_GHOST_REAL_MODEL_MODE=qualification playwright test --config=playwright.real-model.config.ts --project=chrome-real-model",
    "smoke:jets-ghost": "cross-env RUN_REAL_MODEL=1 JETS_GHOST_REAL_MODEL_MODE=smoke playwright test --config=playwright.real-model.config.ts --project=chrome-real-model",
    "verify:browser": "playwright test",
    "verify:production": "playwright test --config=playwright.production.config.ts",
    "verify:all": "npm run verify && npm run verify:browser",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:docs": "tsx scripts/verify-doc-links.ts",
    "build": "npm run verify:content && astro build",
    "verify": "npm run check && npm run test && npm run verify:docs && npm run build && npm run verify:production-artifacts",
    "preview": "astro preview",
    "astro": "astro",
    "upload-image": "tsx scripts/upload-image.ts",
    "capture:og": "tsx scripts/capture-og-image.ts",
    "validate-images": "tsx scripts/validate-images.ts",
    "verify:build-purity": "tsx scripts/verify-build-purity.ts",
    "verify:production-artifacts": "tsx scripts/verify-production-artifacts.ts",
    "test:jets-ghost-design": "tsx --test tests/jets-ghost-experience.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.4.2",
    "@litert-lm/core": "0.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.0.0",
    "astro": "^5.16.6",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "ogl": "^1.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "stemmer": "2.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^5.1.5",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/mdast": "4.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@webgpu/types": "0.1.71",
    "cross-env": "10.1.0",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
